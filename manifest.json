{
  "name": "Tsukihi",
  "version": "2.1",
  "description": "Send URLs to LANraragi or qBittorrent and track download progress.",
  "permissions": [
    "activeTab",
    "storage",
    "notifications",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "https://*/",
    "http://*/"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "tsukihi@lanraragi.extension",
      "strict_min_version": "109.0"
    }
  },
  "options_page": "options.html",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["i18n.js", "background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/get_started16.png",
      "32": "images/get_started32.png",
      "48": "images/get_started48.png",
      "128": "images/get_started128.png"
    }
  },
  "commands": {
    "download-current-tab": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Download the current page to LANraragi"
    },
    "download-current-tab-qb": {
      "suggested_key": {
        "default": "Alt+Shift+Q",
        "mac": "Alt+Shift+Q"
      },
      "description": "Send the current E-Hentai page to qBittorrent"
    },
    "open-download-center": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "Open the Tsukihi download center"
    }
  },
  "icons": {
    "16": "images/get_started16.png",
    "32": "images/get_started32.png",
    "48": "images/get_started48.png",
    "128": "images/get_started128.png"
  },
  "manifest_version": 3
}
